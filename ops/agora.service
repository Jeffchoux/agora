[Unit]
Description=Agora project collaboration gateway
After=network.target

[Service]
Type=simple
User=galaxia
Group=galaxia
WorkingDirectory=/home/galaxia/agora/current
ExecStart=/home/galaxia/agora/current/ops/start.sh
Environment=AGORA_DB=/home/galaxia/.local/share/agora/agora.sqlite
Environment=AGORA_LEGACY_INSTALLATION=1
Environment=AGORA_URL=https://app.galaxia-os.com/agora
Environment=AGORA_ADMIN_TOKEN_FILE=/home/galaxia/.local/share/agora/operator.key
Environment=AGORA_LAYA_TOKEN_FILE=/home/galaxia/.local/share/agora/laya.key
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/galaxia/.local/share/agora
MemoryMax=384M
CPUQuota=50%
TasksMax=48

[Install]
WantedBy=multi-user.target
